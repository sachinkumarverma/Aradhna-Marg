# ==========================================
# ARADHNA MARG - BACKEND ENVIRONMENT CONFIG
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
# Allowed origins for CORS (comma-separated, optional)
CORS_ALLOWED_ORIGINS=https://aradhnamarg.com,https://admin.aradhnamarg.com,http://localhost:5173

# Database Connection (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

# Supabase Storage & Assets
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=aradhna-images

# Backblaze B2 S3-Compatible Storage (Purana Sacred Scripture PDFs)
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET_NAME=aradhna-puranas
B2_ACCESS_KEY_ID=your_b2_access_key_id
B2_SECRET_ACCESS_KEY=your_b2_secret_access_key
PDF_PROXY_ALLOWED_HOSTS=s3.us-east-005.backblazeb2.com

# Admin Authentication (Stateless Single-Tenant JWT)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_ADMIN_EXPIRES_IN=1h

# Google reCAPTCHA v3 (Server-side Verification)
RECAPTCHA_SECRET_KEY=your_recaptcha_v3_secret_key
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ALLOWED_HOSTNAMES=aradhnamarg.com,www.aradhnamarg.com,admin.aradhnamarg.com,localhost,127.0.0.1

# AI Worker & Automation Providers
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
GROQ_DEFAULT_MODEL=openai/gpt-oss-20b
GROQ_LARGE_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=your_openai_api_key_optional
GEMINI_API_KEY=your_gemini_api_key_optional

# YouTube Data API v3 (Channel Sync Automation)
YOUTUBE_API_KEY=your_google_youtube_api_key

# Payment Gateway (Razorpay Devotional Offerings)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email & Notification Services (Brevo / SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_user
SMTP_PASS=your_brevo_smtp_password
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM=Aradhna Marg <support@aradhnamarg.com>
EMAIL_FROM_ADDRESS=support@aradhnamarg.com
EMAIL_SUPPORT_ADDRESS=support@aradhnamarg.com
ADMIN_EMAIL=support@aradhnamarg.com
ADMIN_ALLOWED_EMAILS=your_email@gmail.com

# Multi-Language Translation (Articles & Content)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key
GOOGLE_TRANSLATE_ENABLED=true
TRANSLATION_PROVIDER=google
TRANSLATION_MONTHLY_CHAR_LIMIT=500000
AUTO_TRANSLATE_ON_SAVE=false

# Background Cron & Scheduled Maintenance
CRON_SECRET=your_cron_secret_min_10_chars
