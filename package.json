{
  "name": "daily-bhajans-root",
  "version": "1.0.0",
  "description": "Root workspace for Aradhna Marg",
  "scripts": {
    "frontend": "npm run dev --prefix frontend",
    "backend": "npm run dev --prefix backend",
    "frontend:install": "npm install --prefix frontend",
    "backend:install": "npm install --prefix backend",
    "install:all": "npm run frontend:install && npm run backend:install",
    "dev": "npx concurrently \"npm run backend\" \"npm run frontend\""
  },
  "private": true
}
