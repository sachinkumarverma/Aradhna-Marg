# ==========================================
# ARADHNA MARG - FRONTEND ENVIRONMENT CONFIG
# ==========================================

# API Base URL (Backend endpoint)
# Development: http://localhost:5000/api
# Production: https://api.aradhnamarg.com/api
VITE_API_BASE_URL=http://localhost:5000/api

# Public Production Canonical Domain
VITE_SITE_URL=https://aradhnamarg.com

# Supabase Public Keys (For asset and storage URLs)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google OAuth Client ID (For Devotee Google Sign-In)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Google reCAPTCHA v3 (Public Client Site Key)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_v3_public_site_key

# Razorpay Key ID (Client Key for Devotional Offerings)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Google AdSense Publisher ID (Optional Monetization)
VITE_ADSENSE_PUBLISHER_ID=ca-pub-your_publisher_id
